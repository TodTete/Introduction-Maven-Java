<!-- Logback usa este archivo (en lugar de logback.xml) al ejecutar las pruebas -->
<configuration>
    <appender name="CONSOLA" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%-5level [%logger{0}] %msg%n</pattern>
        </encoder>
    </appender>
    <root level="WARN">
        <appender-ref ref="CONSOLA"/>
    </root>
</configuration>
